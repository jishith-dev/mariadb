import (
  Database,
  Result,
  Row,
  Statement,
  connect
) from "lib.zen"

import (Query) from "query-builder"


fn check(Database db, int code) void {
  if (code != 0) {
    screen(db.error())
    db.close()
    os.exit(1)
  }
}

fn getcount(Database db) long {
  db.query("SELECT COUNT(*) FROM zen_test")

  Result r = db.result()
  Row row = r.next()
  long n = row.getLong(0)

  row.close()
  r.close()

  return n
}


# connect
Database db = connect("127.0.0.1", "root", "", "test", 3306)

if (!db.ok()) {
  screen(db.error())
  os.exit(1)
}

screen("connected")


# query
check(db, db.query("DROP TABLE IF EXISTS zen_test"))
check(db, db.query("CREATE TABLE zen_test (id INT AUTO_INCREMENT PRIMARY KEY, name VARCHAR(50), age INT, score DOUBLE, big BIGINT NULL)"))
check(db, db.query("INSERT INTO zen_test (name, age, score) VALUES ('Raw', 30, 1.5)"))

screen(db.affectedRows())
screen(db.insertId())


# result and row
check(db, db.query("SELECT id, name, age, score, big FROM zen_test"))

Result r = db.result()

screen(r.ok())
screen(r.columnCount())
screen(r.rowCount())

Row row = r.next()

while (row.valid()) {
  screen(row.getInt(0))
  screen(row.getString(1))
  screen(row.getInt(2))
  screen(row.getDouble(3))
  screen(row.getLong(4))
  screen(row.isNull(4))

  row.close()
  row = r.next()
}

r.close()


# prepared statement
Statement st = db.prepare("INSERT INTO zen_test (name, age, score, big) VALUES (?, ?, ?, ?)")

long big = 5000000000L

st.bindString(0, "Prepared")
st.bindInt(1, 25)
st.bindDouble(2, 9.5)
st.bindLong(3, big)

check(db, st.execute())

screen(st.affectedRows())
screen(st.insertId())

st.close()


# prepared select
Statement sel = db.prepare("SELECT id, name, big FROM zen_test WHERE age >= ?")

sel.bindInt(0, 20)

check(db, sel.execute())

screen(sel.columnCount())
screen(sel.rowCount())

Row srow = sel.next()

while (srow.valid()) {
  screen(srow.getInt(0))
  screen(srow.getString(1))
  screen(srow.getLong(2))

  srow.close()
  srow = sel.next()
}

sel.close()


# transaction
check(db, db.begin())
check(db, db.query("INSERT INTO zen_test (name, age) VALUES ('Rollback', 1)"))
check(db, db.rollback())

screen(getcount(db))

check(db, db.begin())
check(db, db.query("INSERT INTO zen_test (name, age) VALUES ('Commit', 2)"))
check(db, db.commit())

screen(getcount(db))


# query-builder
Query q
q.useDialect("mysql")

q.insertInto("zen_test")
q.values(["name", "age"], ["Builder", "40"])

Statement s = db.run(q.build(), q.getParameters())

if (!s.ok()) {
  screen(db.error())
  db.close()
  os.exit(1)
}

screen(s.affectedRows())
screen(s.insertId())
s.close()

q.select(["id", "name", "age"])
q.fromTable("zen_test")
q.where("age", ">=", "30")
q.orderBy("id", "asc")
q.limit(2)

s = db.run(q.build(), q.getParameters())

if (!s.ok()) {
  screen(db.error())
  db.close()
  os.exit(1)
}

screen(s.rowCount())

Row qrow = s.next()

while (qrow.valid()) {
  screen(qrow.getInt(0))
  screen(qrow.getString(1))
  screen(qrow.getInt(2))

  qrow.close()
  qrow = s.next()
}

s.close()

q.update("zen_test")
q.set("age", "41")
q.where("name", "=", "Builder")

s = db.run(q.build(), q.getParameters())

if (!s.ok()) {
  screen(db.error())
  db.close()
  os.exit(1)
}

screen(s.affectedRows())
s.close()

q.deleteFrom("zen_test")
q.where("name", "=", "Builder")

s = db.run(q.build(), q.getParameters())

if (!s.ok()) {
  screen(db.error())
  db.close()
  os.exit(1)
}

screen(s.affectedRows())
s.close()

screen(getcount(db))


# errors
Statement bad = db.prepare("SELEC")

screen(bad.ok())
screen(db.error())

screen(db.query("SELECT * FROM missing_table"))
screen(db.error())


# cleanup
// check(db, db.query("DROP TABLE zen_test"))

db.close()

screen("closed")

